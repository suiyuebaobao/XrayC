XRAYC_NODE_ID=00000000-0000-0000-0000-000000000201
XRAYC_CONTROL_PLANE_URL=http://api.example.invalid:8080
XRAYC_NODE_TOKEN=<set-in-env>
XRAYC_DEPLOY_ARTIFACT_TOKEN=<set-in-env>
XRAYC_DEPLOY_BASE_URL=http://api.example.invalid:8080
XRAYC_DEPLOY_READY_TIMEOUT_SECONDS=120
XRAYC_DEPLOY_START=true
XRAYC_DEPLOY_ROLLBACK_ON_FAILURE=true
XRAYC_DEPLOY_ROLLBACK_REMOVE_EXISTING=false
XRAYC_DISABLE_LEGACY_SYSTEMD_UNITS=false
XRAYC_EXPECTED_LISTEN_PORTS=
XRAYC_HEARTBEAT_INTERVAL_SECONDS=30
XRAYC_TRAFFIC_INTERVAL_SECONDS=60
XRAYC_SESSION_IDLE_SECONDS=180
# 节点 3 地址模型（均可空、至少填一个，占位用 example.com / RFC 5737）：
#   - IP 直连地址（ip_direct_address）：节点公网 IP，给 VLESS-Reality / Shadowsocks 直连，免证书。
#   - 域名直连地址（cert_domain，灰云）：给 Trojan/HY2/(VLESS|Trojan) 的 WS/gRPC/XHTTP+TLS 直连，HTTP-01 签证书。
#   - CF 直连地址（cf_domain，橙云）：经 Cloudflare 代理 (VLESS|Trojan)+(WS/gRPC/XHTTP)+TLS（含 Trojan-WS）。
# cf_enabled 由 cf_domain 非空派生，无独立开关。
#
# XRAYC_TLS_CERT_DOMAINS：节点域名直连证书域名（空格分隔，占位示例 example.com）。当节点存在
# Trojan/HY2/(VLESS|Trojan) 的 WS/gRPC/XHTTP+TLS 直连入口，或 CF 走 cf_cert_mode=reuse_direct 时必须设置：
# 安装脚本会把节点 cert_domain 写进这里，让 access-agent 用 certbot HTTP-01（--standalone，灰云 DNS 直指
# 节点 IP）自动申请直连证书并续期，落 /etc/letsencrypt/live/{域名}/。纯 Reality/SS 节点可留空。
# 真实域名由一键安装/手动安装时填写，不写进示例文件。
XRAYC_TLS_CERT_DOMAINS=
# CF 域名证书模式（cf_cert_mode）：默认 dns01——有 CF API Token 时用 certbot-dns-cloudflare 给橙云域名
# （cf_domain）签它自己的真 LE 证书，CF 入口证书锚定 /etc/letsencrypt/live/{cf_domain}/，certbot renew 自动续期；
# 无 token 时退回 reuse_direct——CF 回源复用上面的灰云直连证书，并要求 CF 控制台 SSL 设 Full（非 strict）。
# DNS-01 真证书下 Full 与 Full(strict) 都成立；本方案不自动改 CF SSL 模式（Token 仅需 DNS 编辑权限），
# 建议用户面板设 Full(strict) 更安全。
XRAYC_CF_CERT_MODE=dns01
# CF API Token（仿 SSH 凭据，仅安装/续期期使用）：cf_cert_mode=dns01 时，一键安装/安装指南携带的 cf_api_token
# 由 access-agent 写到节点本机 /etc/letsencrypt/cloudflare.ini（权限 0600），供 certbot DNS-01 签发 + 续期使用。
# 该 Token 绝不持久化到控制面 DB、不入日志、不入审计、不入心跳、不回显；心跳只上报 CF 证书域名/valid/剩余天数/
# 脱敏错误摘要。此处只放占位，真实 Token 由安装时注入到节点本机 env / ini，不写进示例文件。
XRAYC_CLOUDFLARE_API_TOKEN=<set-in-env>
XRAYC_XRAY_CONFIG_PATH=/etc/xray/config.json
XRAYC_AGENT_STATE_PATH=/var/lib/xrayc/access-agent/state.json
XRAYC_TRAFFIC_BACKLOG_PATH=/var/lib/xrayc/access-agent/traffic-backlog.json
XRAYC_XRAY_ACCESS_LOG_PATH=/var/log/xray/access.log
XRAYC_XRAY_BINARY=/usr/local/bin/xrayc-xray
XRAYC_XRAY_TEST_COMMAND=/usr/local/bin/xrayc-xray run -test -format json -config "$XRAYC_XRAY_CONFIG"
XRAYC_XRAY_CONTAINER_NAME=xrayc-xray-example
XRAYC_XRAY_RELOAD_COMMAND='curl --fail --silent --show-error --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/xrayc-xray-example/restart?t=0" >/dev/null'
XRAYC_XRAY_START_COMMAND='curl --fail --silent --show-error --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/xrayc-xray-example/start" >/dev/null'
XRAYC_XRAY_STOP_COMMAND='curl --fail --silent --show-error --unix-socket /var/run/docker.sock -X POST "http://localhost/containers/xrayc-xray-example/stop?t=10" >/dev/null'
XRAYC_XRAY_API_SERVER=127.0.0.1:10085
XRAYC_XRAY_API_LISTEN_HOST=127.0.0.1
XRAYC_XRAY_API_LISTEN_PORT=10085
XRAYC_RATE_LIMITER_ENABLED=true
XRAYC_RATE_LIMITER_DRY_RUN=false
XRAYC_RATE_LIMITER_INTERFACE=eth0
XRAYC_RATE_LIMITER_IFB_INTERFACE=ifb-xrayc
XRAYC_RATE_LIMITER_ROOT_RATE_BPS=10000000000
XRAYC_RATE_LIMITER_PLAN_PATH=/var/lib/xrayc/access-agent/limiter-plan.sh
# 监控中心宿主磁盘采集挂载点（阶段B）：部署把宿主根 / 只读挂到容器 /hostfs，access-agent
# 对该路径跑 libc::statvfs 读宿主磁盘 used/total 上报心跳 node_metrics。/proc/stat、/proc/meminfo
# 因 network_mode: host + 容器默认即宿主视图无需额外挂载，只有磁盘需要这条 host 根挂载。
# 该挂载点不存在时 agent 自动回退 "/"（容器/宿主根），不会因缺挂载而丢整份指标。
XRAYC_HOST_FS_ROOT=/hostfs
RUST_LOG=info,xrayc_access_agent=debug
